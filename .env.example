# .env.example

### =============== Databricks Connection ===============

# Databricks workspace URL
DATABRICKS_HOST="https://<workspace-id>.cloud.databricks.com"

# ======= Auth: PAT Token (default) =======
# Use either this OR OAuth credentials
DATABRICKS_TOKEN=your_pat_token_here

# ======= Auth: OAuth (Service Principal or User) =======
DATABRICKS_CLIENT_ID=your_oauth_client_id_here
DATABRICKS_CLIENT_SECRET=your_oauth_client_secret_here
DATABRICKS_TENANT_ID=your_oauth_tenant_id_here

### =============== Execution Mode ===============
# Set to "true" to use Serverless SQL warehouse
# Set to "false" or leave unset to use a cluster
DATABRICKS_SERVERLESS=true

# If using a cluster (and DATABRICKS_SERVERLESS is false), set the cluster ID
DATABRICKS_CLUSTER_ID=your_cluster_id_here